# OpenRouter API Key for Autonomous LLM Research Agent
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection (defaults to Claude 3.5 Sonnet / GPT-4o mini)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: Direct OpenAI / Anthropic fallback if needed
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent Execution Settings
CONCURRENCY=5
MAX_RETRIES=3
